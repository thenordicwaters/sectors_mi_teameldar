# Copy to .env and fill in. Never commit .env.

# Sectors Financial API v2
# Key is sent in the Authorization header (not Bearer).
# Get a key: https://sectors.app/api
SECTORS_API_KEY=
SECTORS_API_BASE_URL=https://api.sectors.app/v2

# Local API
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Frontend origin for CORS in development
FRONTEND_ORIGIN=http://localhost:5173
