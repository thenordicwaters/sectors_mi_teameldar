# Copy to .env and fill in. Never commit .env.

# Sectors Financial API v2
# Key is sent in the Authorization header (not Bearer).
# Get a key: https://sectors.app/api
SECTORS_API_KEY=
SECTORS_API_BASE_URL=https://api.sectors.app
SECTORS_CREDIT_BUDGET=1000
# Credits already billed on the Sectors portal before this repo's SQLite ledger.
# Official log 20 Sept 2026: 53 (pre-snapshot exploration + one /v2/subsectors/ call).
SECTORS_OPENING_CREDITS_USED=53
SECTORS_SQLITE_PATH=data/sectors.db

# Local API
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Frontend origin for CORS in development
FRONTEND_ORIGIN=http://localhost:5173
